root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,props,csproj,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:warning
# CA1062: argument null checks are covered by nullable reference types.
dotnet_diagnostic.CA1062.severity = none
# CA2007: ConfigureAwait(false) is required in plugin code.
dotnet_diagnostic.CA2007.severity = warning
# CA5394: Random drives playlist shuffling, not security decisions.
dotnet_diagnostic.CA5394.severity = none
# CA1724: Jellyfin plugins conventionally name the entry type Plugin.
dotnet_diagnostic.CA1724.severity = none
# CA1707: xunit test names use underscores.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
